#!/usr/bin/env python3
"""speak-deepgram — synthesize stdin text via Deepgram TTS.

Writes raw s16le mono 24 kHz PCM to stdout (for direct-mode ffplay), or a WAV
file with --save FILE. All logic lives in lib/speakd/deepgram.py (stdlib only,
so plain python3 is enough; no uv env needed).
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from speakd.deepgram import main

if __name__ == "__main__":
    sys.exit(main())
