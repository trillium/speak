#!/usr/bin/env bash
set -euo pipefail

# Hard kill-switch: when this flag file exists, speak is fully disabled — no
# daemon start, no audio, no tones. Every invocation (hooks included) no-ops.
# Reverse with: rm ~/.speak-disabled
if [[ -f "${HOME}/.speak-disabled" ]]; then exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
KOKORO_DIR="${HOME}/.local/share/speak/kokoro"
PIPER_VOICES_DIR="${HOME}/.local/share/speak/voices"
SOCK_PATH="/tmp/speak-${USER}.sock"
ENGINE="kokoro"
DEFAULT_KOKORO_VOICE="af_heart"
DEFAULT_PIPER_VOICE="en_US-ryan-high"
SPEED="1.26"  # mirrors lib/speakd/config.py DEFAULT_SPEED
SAVE_FILE=""
VOICE=""
CALLER="${SPEAK_CALLER:-}"
ENQUEUE_BACKEND="${SPEAK_ENQUEUE_BACKEND:-auto}"  # auto, c, python
DEVICE=""
FLAGGED_FILE="${SCRIPT_DIR}/../config/flagged.json"
MUTE_FILE="/tmp/speak-${USER}.muted"

# launchd supervision (replaces the old bash watchdog subshell)
LAUNCHD_LABEL="com.speak.daemon"
LAUNCHD_PLIST_SRC="${SCRIPT_DIR}/../launchd/${LAUNCHD_LABEL}.plist"
LAUNCHD_PLIST_DST="${HOME}/Library/LaunchAgents/${LAUNCHD_LABEL}.plist"
LAUNCHD_DOMAIN="gui/$(id -u)"

# Auto-detect caller from git repo name or cwd basename
_auto_detect_caller() {
    # Explicit --caller or SPEAK_CALLER takes priority
    if [[ -n "${CALLER}" ]]; then
        return
    fi
    # Try git repo name first
    local repo_root
    if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        CALLER="$(basename "${repo_root}")"
    else
        CALLER="$(basename "${PWD}")"
    fi
}

# Find the Claude Code ancestor PID to use as session identity.
# All subagents within one Claude Code session share the same ancestor.
# Falls back to PPID if no Claude Code ancestor is found.
_detect_session() {
    local pid="$$"
    local parent
    # Walk up the process tree looking for a "claude" process
    for _ in 1 2 3 4 5 6 7 8; do
        parent="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ')"
        [[ -z "${parent}" || "${parent}" == "0" || "${parent}" == "1" ]] && break
        local comm
        comm="$(ps -o comm= -p "${parent}" 2>/dev/null)"
        if [[ "${comm}" == *"/claude" || "${comm}" == "claude" ]]; then
            echo "${parent}"
            return
        fi
        pid="${parent}"
    done
    # Fallback: use PPID
    echo "${PPID}"
}

SESSION=""

usage() {
    cat <<'EOF'
Usage: speak [OPTIONS] [TEXT...]

Speak text aloud using local TTS (Kokoro or Piper).

Text can be provided as arguments or piped via stdin.

Options:
  --engine ENGINE   TTS engine: kokoro (default) or piper
  --voice NAME      Voice name (default: af_heart for kokoro, en_US-ryan-high for piper)
  --speed FLOAT     Speech speed (default: 1.26)
  --save FILE       Save to WAV file instead of playing
  --voices          List available voices for the selected engine
  --devices         List audio output devices (with index numbers)
  --device ID       Audio device for daemon (index or name substring)
  --set-device ID   Pin audio device (persists across daemon restarts)
  --set-device default   Clear the pin; follow the current system default
  --show-device     Show the pinned audio device setting
  --daemon          Show daemon status / start it
  --restart         Restart the daemon
  --stop            Stop the daemon
  --enqueue         Queue text and return immediately (default, and only mode)
  --queue           Show playback queue status
  --skip            Skip currently playing queued item
  --clear           Clear pending playback queue
  --replay          Replay the last queued item
  --pause           Toggle pause/resume on current playback
  --resume          Explicitly resume paused playback
  --replay-id ID    Replay a history entry by ID (same voice, no new history row)
  --clause N        Start replay from clause N (use with --replay-id)
  --stats           Show daemon stats (uptime, cache, queue totals)
  --caller NAME     Caller identity (plays a unique tone per caller)
  --history [N]     Show last N spoken texts as JSON array (default: 10)
  --caller-history NAME [N]  Show last N texts from a specific caller (default: 10)
  --session-history PID [N]  Show last N texts from a session PID (default: 10)
  --agent-summary PID  Summarize what a Claude Code session (by PID) has said
  --agent-repeat PID [N]  Replay last N things a session said (default: 3)
  --flag WORD/PHRASE  Flag a word or phrase that sounds wrong (triage later)
  --flagged         Show all flagged words/phrases
  --unflag WORD     Remove a word/phrase from the flagged list
  --mute            Mute audio mode (speak commands will fail fast)
  --unmute          Unmute audio mode
  --voice-lock NAME VOICE  Lock a caller name to a specific voice
  --voice-unlock NAME      Unlock a caller name
  --voice-locks            List all locked voice assignments
  --voice-pool             Show current pool status (locks + session claims)
  --voice-weight VOICE N   Set weight for a voice (higher = less preferred, 0 = remove)
  --voice-weights          List all voice weights
  --voice-release VOICE    Release active claims on a voice (daemon reassigns on next enqueue)
  --voice-reject [VOICE]   Deprioritize a voice and release its claims (auto-detects if omitted)
  --voice-keep             Lock the agent's current pool-assigned voice permanently
  --resume-mid-clause [on|off]  Toggle or query resume-from-interrupted-clause behavior
  --subscribe       Subscribe to real-time PCM audio stream (stdout) + metadata (stderr)
  --session PID     Set session PID for history tracking (used with --enqueue)
  --rewrites CMD    Manage pronunciation/phrase rewrites:
                      list            Show all rewrites with review status
                      pending         Show unreviewed entries
                      accept K        Mark entry K as accepted
                      reject K        Mark entry K as rejected
                      unnecessary K   Remove entry (Kokoro says it right)
                      fix K VALUE     Change the replacement for K and speak it
                      test K          Speak the before/after for entry K
                      test-all        Speak all unreviewed entries
                      review [F]      Re-speak by status (accepted/rejected/...)
                      regenerate      Regenerate all rejected via LLM
  -h, --help        Show this help

Trim config (config/trim.yaml):
  Controls silence between clauses. Text is split at punctuation and each
  clause is trimmed of Kokoro's built-in silence (~280ms lead, ~360ms trail),
  then re-padded based on the ending punctuation character. Edit the file
  to change values — takes effect on the next synthesis, no restart needed.

  Default values:
    . ? !  = 300ms gap (sentence endings)
    : ; -  = 220ms gap (mid-sentence breaks)
    ,      = 160ms gap (list items, clauses)

Broadcast subscribe:
  Clients can subscribe to receive a copy of all audio + metadata events.
  PCM format: signed 16-bit LE mono at 24kHz.
  Use speak-client --subscribe to connect, or send {"command":"subscribe"}
  over the daemon socket.

Kokoro voices (prefix: af_=American female, am_=American male, bf_/bm_=British):
  af_heart, af_sarah, af_bella, af_nova, af_sky, af_nicole, af_alloy, ...
  am_adam, am_michael, am_eric, am_liam, am_onyx, am_puck, am_fenrir, ...

Audio device selection:
  speak --devices                      List output devices with index numbers
  speak --device 3 --daemon            Start daemon on device index 3
  speak --device "Jabra" --daemon      Start daemon matching device name
  speak --set-device "Jabra"           Pin a device; persists across restarts
  speak --set-device default           Clear the pin; follow system default
  speak --show-device                  Show the pinned device setting

Examples:
  speak "Hello world"
  echo "piped text" | speak
  speak --voice am_adam "Male voice"
  speak --engine piper --voice en_US-lessac-high "Using Piper"
  speak --speed 1.2 "Faster speech"
  speak --save output.wav "Saved to file"
  speak --voices
  speak --enqueue "first" && speak --enqueue "second"
  speak --enqueue --caller agent1 "With caller tone"
  speak --agent-summary 12345
  speak --agent-repeat 12345 5
  speak --queue
  speak --skip
  speak --clear
  speak --replay
EOF
    exit 0
}

# --- Dependency checks ---
if ! command -v uv >/dev/null 2>&1; then
    echo "speak: missing required tool: uv" >&2
    echo "Install it and try again." >&2
    exit 1
fi

# ffplay is only needed for non-daemon paths (direct-mode fallback, piper engine)
_require_ffplay() {
    if ! command -v ffplay >/dev/null 2>&1; then
        echo "speak: this mode requires ffplay (install ffmpeg)" >&2
        exit 1
    fi
}

# --- Failure logging ---
# Append a JSON line recording a dropped/failed speech attempt so silence is
# observable after the fact. Best-effort: never breaks the caller (all failures
# swallowed, always returns 0). Rotates at 5 MB like the daemon log.
#   {ts, stage, caller, exit_code, text_head (first 80 chars)}
_log_failure() {
    local stage="$1"
    local exit_code="${2:-}"
    local text="${3:-}"
    local failures_dir="${HOME}/.local/share/speak"
    local failures_file="${failures_dir}/failures.jsonl"

    mkdir -p "${failures_dir}" 2>/dev/null || return 0

    # Rotate if over 5 MB
    if [[ -f "${failures_file}" ]] && \
       [[ $(stat -f%z "${failures_file}" 2>/dev/null || echo 0) -gt 5242880 ]]; then
        mv "${failures_file}" "${failures_file}.1" 2>/dev/null || true
    fi

    local ts
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Normalize exit_code to a JSON number; -1 if unknown/non-numeric
    [[ "${exit_code}" =~ ^-?[0-9]+$ ]] || exit_code=-1
    # First 80 chars, newlines flattened so each record stays one line
    local text_head="${text:0:80}"
    text_head="${text_head//$'\n'/ }"
    local caller="${CALLER:-}"

    if command -v jq >/dev/null 2>&1; then
        jq -cn \
            --arg ts "${ts}" \
            --arg stage "${stage}" \
            --arg caller "${caller}" \
            --argjson exit_code "${exit_code}" \
            --arg text_head "${text_head}" \
            '{ts:$ts, stage:$stage, caller:$caller, exit_code:$exit_code, text_head:$text_head}' \
            >> "${failures_file}" 2>/dev/null || true
    else
        # Minimal-escaping fallback: escape backslash then double-quote
        local esc_head="${text_head//\\/\\\\}"; esc_head="${esc_head//\"/\\\"}"
        local esc_caller="${caller//\\/\\\\}"; esc_caller="${esc_caller//\"/\\\"}"
        printf '{"ts":"%s","stage":"%s","caller":"%s","exit_code":%s,"text_head":"%s"}\n' \
            "${ts}" "${stage}" "${esc_caller}" "${exit_code}" "${esc_head}" \
            >> "${failures_file}" 2>/dev/null || true
    fi
    return 0
}

# --- Daemon management helpers ---
daemon_is_running() {
    [[ -S "${SOCK_PATH}" ]] && [[ -f "${SOCK_PATH}.pid" ]] && kill -0 "$(cat "${SOCK_PATH}.pid")" 2>/dev/null
}

launchd_service_loaded() {
    launchctl print "${LAUNCHD_DOMAIN}/${LAUNCHD_LABEL}" >/dev/null 2>&1
}

# Kill any legacy pre-launchd watchdog subshell + daemon (migration path).
_kill_legacy_watchdog() {
    if [[ -f "${SOCK_PATH}.watchdog.pid" ]]; then
        local wpid
        wpid="$(cat "${SOCK_PATH}.watchdog.pid" 2>/dev/null)"
        [[ -n "${wpid}" ]] && kill "${wpid}" 2>/dev/null || true
        rm -f "${SOCK_PATH}.watchdog.pid"
    fi
}

start_daemon() {
    if daemon_is_running; then
        return 0
    fi

    local model="${KOKORO_DIR}/kokoro-v1.0.onnx"
    local voices="${KOKORO_DIR}/voices-v1.0.bin"

    if [[ ! -f "${model}" || ! -f "${voices}" ]]; then
        echo "speak: kokoro model files not found in ${KOKORO_DIR}" >&2
        _log_failure "start_daemon:model_missing" 1 "${TEXT:-}"
        return 1
    fi

    # Any legacy bash-watchdog daemon must go before launchd owns supervision.
    _kill_legacy_watchdog

    mkdir -p "${HOME}/.local/share/speak" "${HOME}/Library/LaunchAgents"

    # Persistent device selection is a speak setting now (see --set-device /
    # --show-device); the daemon reads it on startup. --device here is only a
    # one-off launch override and does NOT reach the launchd-managed daemon.
    if [[ -n "${DEVICE}" ]]; then
        echo "speak: note — to pin an output device that survives restarts, use:" >&2
        echo "         speak --set-device \"${DEVICE}\"" >&2
        echo "       (--device is a one-off override and won't reach the launchd daemon)." >&2
    fi

    if launchd_service_loaded; then
        # Already bootstrapped — (re)start the existing service.
        launchctl kickstart "${LAUNCHD_DOMAIN}/${LAUNCHD_LABEL}" >/dev/null 2>&1 || true
    else
        # Install the tracked plist and bootstrap it into the gui domain.
        cp "${LAUNCHD_PLIST_SRC}" "${LAUNCHD_PLIST_DST}"
        # bootstrap can race a just-departed instance (I/O error 5) — retry.
        local btries=0
        until launchctl bootstrap "${LAUNCHD_DOMAIN}" "${LAUNCHD_PLIST_DST}" 2>/dev/null; do
            # Maybe it became loaded via the race — accept that and move on.
            launchd_service_loaded && break
            btries=$((btries + 1))
            if [[ ${btries} -ge 12 ]]; then
                echo "speak: launchctl bootstrap failed after ${btries} tries" >&2
                _log_failure "start_daemon:bootstrap_failed" 1 "${TEXT:-}"
                return 1
            fi
            sleep 0.5
        done
    fi

    echo "speak: starting daemon via launchd (log: ${HOME}/.local/share/speak/daemon.log)..." >&2

    # Wait for the socket. Model load is ~10-15s, so allow up to ~30s.
    local tries=0
    while [[ ! -S "${SOCK_PATH}" ]] && [[ $tries -lt 60 ]]; do
        sleep 0.5
        tries=$((tries + 1))
    done

    if [[ ! -S "${SOCK_PATH}" ]]; then
        echo "speak: daemon failed to start (socket did not appear)" >&2
        _log_failure "start_daemon:socket_timeout" 1 "${TEXT:-}"
        return 1
    fi
    echo "speak: daemon ready." >&2
}

stop_daemon() {
    # Migration: kill any legacy watchdog + daemon from the pre-launchd era.
    _kill_legacy_watchdog

    if launchd_service_loaded; then
        launchctl bootout "${LAUNCHD_DOMAIN}/${LAUNCHD_LABEL}" 2>/dev/null || true
        # Wait for the service to actually depart so KeepAlive can't race us.
        local gtries=0
        while launchd_service_loaded && [[ ${gtries} -lt 40 ]]; do
            sleep 0.25
            gtries=$((gtries + 1))
        done
        echo "speak: daemon stopped (launchd bootout)" >&2
    else
        echo "speak: launchd service not loaded" >&2
    fi

    # Kill any lingering/orphaned daemon pid and clean stale socket + pid files.
    if [[ -f "${SOCK_PATH}.pid" ]]; then
        local pid
        pid="$(cat "${SOCK_PATH}.pid" 2>/dev/null)"
        if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" 2>/dev/null || true
        fi
    fi
    rm -f "${SOCK_PATH}" "${SOCK_PATH}.pid"
}

restart_daemon() {
    if ! launchd_service_loaded; then
        # Not bootstrapped yet — fall back to a clean stop + start.
        stop_daemon
        start_daemon
        return
    fi

    local old_pid=""
    [[ -f "${SOCK_PATH}.pid" ]] && old_pid="$(cat "${SOCK_PATH}.pid" 2>/dev/null)"
    echo "speak: restarting daemon (launchd kickstart -k)..." >&2
    launchctl kickstart -k "${LAUNCHD_DOMAIN}/${LAUNCHD_LABEL}" >/dev/null 2>&1 || true

    # Wait until the pid file shows a NEW live pid (kickstart -k SIGKILLs, so the
    # old socket file may linger until the fresh daemon unlinks + rebinds it).
    local tries=0 new_pid=""
    while [[ $tries -lt 70 ]]; do
        sleep 0.5
        if [[ -S "${SOCK_PATH}" && -f "${SOCK_PATH}.pid" ]]; then
            new_pid="$(cat "${SOCK_PATH}.pid" 2>/dev/null)"
            if [[ -n "${new_pid}" && "${new_pid}" != "${old_pid}" ]] && kill -0 "${new_pid}" 2>/dev/null; then
                break
            fi
        fi
        tries=$((tries + 1))
    done

    if [[ -n "${new_pid}" && "${new_pid}" != "${old_pid}" ]] && kill -0 "${new_pid}" 2>/dev/null; then
        echo "speak: daemon ready (pid ${new_pid})." >&2
    else
        echo "speak: daemon failed to restart" >&2
        _log_failure "restart:socket_timeout" 1 "${TEXT:-}"
        return 1
    fi
}

# --- Parse arguments ---
LIST_VOICES=false
LIST_DEVICES=false
SHOW_DEVICE=false
DAEMON_CMD=""
QUEUE_CMD=""
TEXT_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)    usage ;;
        --engine)     ENGINE="$2"; shift 2 ;;
        --voice)      VOICE="$2"; shift 2 ;;
        --speed)      SPEED="$2"; shift 2 ;;
        --save)       SAVE_FILE="$2"; shift 2 ;;
        --voices)     LIST_VOICES=true; shift ;;
        --devices)    LIST_DEVICES=true; shift ;;
        --device)     DEVICE="$2"; shift 2 ;;
        --set-device) SET_DEVICE="$2"; shift 2 ;;
        --show-device) SHOW_DEVICE=true; shift ;;
        --daemon)     DAEMON_CMD="status"; shift ;;
        --restart)    DAEMON_CMD="restart"; shift ;;
        --stop)       DAEMON_CMD="stop"; shift ;;
        --caller)     CALLER="$2"; shift 2 ;;
        --enqueue)    shift ;;  # accepted for compatibility; enqueue is the only playback mode
        --queue)      QUEUE_CMD="queue_status"; shift ;;
        --skip)       QUEUE_CMD="skip"; shift ;;
        --clear)      QUEUE_CMD="clear"; shift ;;
        --replay)     QUEUE_CMD="replay"; shift ;;
        --pause)      QUEUE_CMD="toggle_pause"; shift ;;
        --resume)     QUEUE_CMD="resume"; shift ;;
        --replay-id)  REPLAY_ID="$2"; shift 2 ;;
        --clause)     REPLAY_CLAUSE="$2"; shift 2 ;;
        --play-tone)  PLAY_TONE=true; shift ;;
        --stats)      QUEUE_CMD="stats"; shift ;;
        --offset)     HISTORY_OFFSET="$2"; shift 2 ;;
        --history)
            HISTORY_N="${2:-10}"; shift
            # Shift again only if $2 was a number (not another flag or end of args)
            if [[ "${HISTORY_N}" =~ ^[0-9]+$ ]]; then
                shift 2>/dev/null || true
            else
                HISTORY_N=10
            fi
            QUEUE_CMD="history"
            ;;
        --caller-history)
            CALLER_HISTORY_NAME="${2:-}"
            if [[ -z "${CALLER_HISTORY_NAME}" ]]; then
                echo "speak: --caller-history requires a caller name" >&2; exit 1
            fi
            shift 2
            CALLER_HISTORY_N="${1:-10}"
            if [[ "${CALLER_HISTORY_N}" =~ ^[0-9]+$ ]]; then
                shift 2>/dev/null || true
            else
                CALLER_HISTORY_N=10
            fi
            ;;
        --session-history)
            SESSION_HISTORY_ID="${2:-}"
            if [[ -z "${SESSION_HISTORY_ID}" ]]; then
                echo "speak: --session-history requires a session PID" >&2; exit 1
            fi
            shift 2
            SESSION_HISTORY_N="${1:-10}"
            if [[ "${SESSION_HISTORY_N}" =~ ^[0-9]+$ ]]; then
                shift 2>/dev/null || true
            else
                SESSION_HISTORY_N=10
            fi
            ;;
        --agent-summary)
            AGENT_SUMMARY_PID="${2:-}"
            if [[ -z "${AGENT_SUMMARY_PID}" ]]; then
                echo "speak: --agent-summary requires a PID" >&2; exit 1
            fi
            shift 2
            ;;
        --agent-repeat)
            AGENT_REPEAT_PID="${2:-}"
            if [[ -z "${AGENT_REPEAT_PID}" ]]; then
                echo "speak: --agent-repeat requires a PID" >&2; exit 1
            fi
            shift 2
            AGENT_REPEAT_N="${1:-3}"
            if [[ $# -gt 0 && "${AGENT_REPEAT_N}" =~ ^[0-9]+$ ]]; then
                shift
            else
                AGENT_REPEAT_N=3
            fi
            ;;
        --flag)
            shift
            _flag_input="$*"
            if [[ -z "${_flag_input}" ]]; then
                echo "speak: --flag requires a word or phrase" >&2; exit 1
            fi
            if [[ ! -f "${FLAGGED_FILE}" ]]; then
                echo '[]' > "${FLAGGED_FILE}"
            fi
            _flag_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            # Split on commas, trim whitespace, flag each entry
            IFS=',' read -ra _flag_entries <<< "${_flag_input}"
            for _flag_entry in "${_flag_entries[@]}"; do
                # Trim leading/trailing whitespace
                _flag_phrase="$(echo "${_flag_entry}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                if [[ -z "${_flag_phrase}" ]]; then continue; fi
                _flag_tmp="$(mktemp)"
                jq --arg w "${_flag_phrase}" --arg t "${_flag_ts}" \
                    '. + [{"text": $w, "flagged_at": $t}]' "${FLAGGED_FILE}" > "${_flag_tmp}" \
                    && mv "${_flag_tmp}" "${FLAGGED_FILE}"
                echo "Flagged: ${_flag_phrase}"
            done
            exit 0
            ;;
        --flagged)
            if [[ ! -f "${FLAGGED_FILE}" ]] || [[ "$(jq length "${FLAGGED_FILE}")" == "0" ]]; then
                echo "No flagged words/phrases."
            else
                jq -r '.[] | "\(.text)  (\(.flagged_at))"' "${FLAGGED_FILE}"
            fi
            exit 0
            ;;
        --unflag)
            shift
            _flag_phrase="$*"
            if [[ -z "${_flag_phrase}" ]]; then
                echo "speak: --unflag requires a word or phrase" >&2; exit 1
            fi
            if [[ -f "${FLAGGED_FILE}" ]]; then
                _flag_tmp="$(mktemp)"
                jq --arg w "${_flag_phrase}" '[.[] | select(.text != $w)]' "${FLAGGED_FILE}" > "${_flag_tmp}" \
                    && mv "${_flag_tmp}" "${FLAGGED_FILE}"
            fi
            echo "Unflagged: ${_flag_phrase}"
            exit 0
            ;;
        --voice-lock)
            _vl_name="${2:-}"
            _vl_voice="${3:-}"
            if [[ -z "${_vl_name}" || -z "${_vl_voice}" ]]; then
                echo "speak: --voice-lock requires NAME VOICE" >&2; exit 1
            fi
            _vl_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vl_file}" ]]; then
                echo '{"locks":{}}' > "${_vl_file}"
            fi
            _vl_tmp="$(mktemp)"
            jq --arg n "${_vl_name}" --arg v "${_vl_voice}" \
                '.locks[$n] = {"voice": $v, "gain": 1.0}' "${_vl_file}" > "${_vl_tmp}" \
                && mv "${_vl_tmp}" "${_vl_file}"
            echo "Locked ${_vl_name} to ${_vl_voice}"
            exit 0
            ;;
        --voice-unlock)
            _vu_name="${2:-}"
            if [[ -z "${_vu_name}" ]]; then
                echo "speak: --voice-unlock requires NAME" >&2; exit 1
            fi
            _vu_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ -f "${_vu_file}" ]]; then
                _vu_tmp="$(mktemp)"
                jq --arg n "${_vu_name}" 'del(.locks[$n])' "${_vu_file}" > "${_vu_tmp}" \
                    && mv "${_vu_tmp}" "${_vu_file}"
            fi
            echo "Unlocked ${_vu_name}"
            exit 0
            ;;
        --voice-locks)
            _vl_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vl_file}" ]] || [[ "$(jq '.locks | length' "${_vl_file}")" == "0" ]]; then
                echo "No voice locks."
            else
                jq -r '.locks | to_entries[] | "\(.key)  →  \(.value.voice)  (gain: \(.value.gain))"' "${_vl_file}"
            fi
            exit 0
            ;;
        --voice-pool)
            QUEUE_CMD="voice_pool_status"; shift ;;
        --voice-weight)
            _vw_voice="${2:-}"
            _vw_n="${3:-}"
            if [[ -z "${_vw_voice}" || -z "${_vw_n}" ]]; then
                echo "speak: --voice-weight requires VOICE N" >&2; exit 1
            fi
            _vw_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vw_file}" ]]; then
                echo '{"locks":{},"weights":{}}' > "${_vw_file}"
            fi
            _vw_tmp="$(mktemp)"
            if [[ "${_vw_n}" == "0" ]]; then
                # Weight 0 = remove from weights dict
                jq --arg v "${_vw_voice}" 'if .weights then .weights |= del(.[$v]) else . end' "${_vw_file}" > "${_vw_tmp}" \
                    && mv "${_vw_tmp}" "${_vw_file}"
                echo "Cleared weight for ${_vw_voice}"
            else
                jq --arg v "${_vw_voice}" --argjson n "${_vw_n}" \
                    '.weights[$v] = $n' "${_vw_file}" > "${_vw_tmp}" \
                    && mv "${_vw_tmp}" "${_vw_file}"
                echo "Set ${_vw_voice} weight to ${_vw_n}"
            fi
            exit 0
            ;;
        --voice-weights)
            _vw_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vw_file}" ]] || [[ "$(jq '.weights | length' "${_vw_file}" 2>/dev/null)" == "0" ]]; then
                echo "No voice weights set."
            else
                jq -r '.weights | to_entries | sort_by(.value) | reverse | .[] | "\(.key)  weight: \(.value)"' "${_vw_file}"
            fi
            exit 0
            ;;
        --voice-release)
            _vr_voice="${2:-}"
            if [[ -z "${_vr_voice}" ]]; then
                echo "speak: --voice-release requires VOICE" >&2; exit 1
            fi
            if ! daemon_is_running; then
                echo "speak: daemon not running (start with: speak --daemon)" >&2
                exit 1
            fi
            _vr_json="$(jq -cn --arg v "${_vr_voice}" '{voice: $v}')"
            _vr_resp="$(python3 "${SCRIPT_DIR}/speak-client" --command voice_release --json "${_vr_json}")"
            _vr_count="$(printf '%s' "${_vr_resp}" | jq -r '(.released // []) | length')"
            if [[ "${_vr_count}" -gt 0 ]]; then
                echo "Released ${_vr_count} claim(s) on ${_vr_voice}:"
                printf '%s' "${_vr_resp}" | jq -r '.released[] | "  \(.)"'
            else
                echo "No active claims on ${_vr_voice}"
            fi
            exit 0
            ;;
        --voice-reject)
            _vj_voice="${2:-}"
            # If a voice name was provided (not another flag), consume it
            if [[ -n "${_vj_voice}" && "${_vj_voice}" != --* ]]; then
                shift  # consume the voice arg (exit 0 below ends the loop)
            else
                # No voice given — auto-detect from caller's pool assignment
                _vj_voice=""
                _auto_detect_caller
                if [[ -z "${CALLER}" ]]; then
                    echo "speak: could not detect caller name" >&2; exit 1
                fi
                _vj_db="/tmp/speak-${USER}-history.db"
                if [[ ! -f "${_vj_db}" ]]; then
                    echo "speak: no history database found" >&2; exit 1
                fi
                _vj_voice="$(sqlite3 "${_vj_db}" "SELECT voice FROM history WHERE caller = '${CALLER}' AND voice != '' ORDER BY id DESC LIMIT 1")"
                if [[ -z "${_vj_voice}" ]]; then
                    echo "speak: no voice found for caller '${CALLER}'" >&2; exit 1
                fi
                echo "speak: detected voice '${_vj_voice}' for caller '${CALLER}'"
            fi
            # Step 1: Set weight to 100 (deprioritize)
            _vj_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vj_file}" ]]; then
                echo '{"locks":{},"weights":{}}' > "${_vj_file}"
            fi
            _vj_tmp="$(mktemp)"
            jq --arg v "${_vj_voice}" --argjson n 100 \
                '.weights[$v] = $n' "${_vj_file}" > "${_vj_tmp}" \
                && mv "${_vj_tmp}" "${_vj_file}"
            # Step 2: Release claims via daemon (if running)
            if daemon_is_running; then
                _vj_json="$(jq -cn --arg v "${_vj_voice}" '{voice: $v}')"
                _vj_count="$(python3 "${SCRIPT_DIR}/speak-client" --command voice_release --json "${_vj_json}" | jq -r '(.released // []) | length')"
                if [[ "${_vj_count}" -gt 0 ]]; then
                    echo "Released ${_vj_count} session(s) from ${_vj_voice}"
                fi
            fi
            echo "Rejected ${_vj_voice} — deprioritized and released. New voice assigned on next enqueue."
            exit 0
            ;;
        --voice-keep)
            _auto_detect_caller
            if [[ -z "${CALLER}" ]]; then
                echo "speak: could not detect caller name" >&2; exit 1
            fi
            _vk_db="/tmp/speak-${USER}-history.db"
            if [[ ! -f "${_vk_db}" ]]; then
                echo "speak: no history database found" >&2; exit 1
            fi
            _vk_voice="$(sqlite3 "${_vk_db}" "SELECT voice FROM history WHERE caller = '${CALLER}' AND voice != '' ORDER BY id DESC LIMIT 1")"
            if [[ -z "${_vk_voice}" ]]; then
                echo "speak: no voice assignment found for caller '${CALLER}'" >&2; exit 1
            fi
            # Lock it
            _vk_file="${SCRIPT_DIR}/../config/voices.json"
            if [[ ! -f "${_vk_file}" ]]; then
                echo '{"locks":{},"weights":{}}' > "${_vk_file}"
            fi
            _vk_tmp="$(mktemp)"
            jq --arg n "${CALLER}" --arg v "${_vk_voice}" \
                '.locks[$n] = {"voice": $v, "gain": 1.0}' "${_vk_file}" > "${_vk_tmp}" \
                && mv "${_vk_tmp}" "${_vk_file}"
            echo "Locked ${CALLER} to ${_vk_voice}"
            exit 0
            ;;
        --resume-mid-clause)
            _rmc_val="${2:-}"
            if [[ "${_rmc_val}" == "on" || "${_rmc_val}" == "off" ]]; then
                shift  # consume the on/off value
            fi
            QUEUE_CMD="resume_mid_clause"
            RESUME_MID_CLAUSE_VAL="${_rmc_val}"
            shift
            ;;
        --rewrites)   python3 "${SCRIPT_DIR}/speak-test-rewrites" "${@:2}"; exit $? ;;
        --mute)       touch "${MUTE_FILE}"; echo "speak: audio mode muted" >&2; exit 0 ;;
        --unmute)     rm -f "${MUTE_FILE}"; echo "speak: audio mode unmuted" >&2; exit 0 ;;
        --enqueue-backend) ENQUEUE_BACKEND="$2"; shift 2 ;;
        --)           shift; TEXT_ARGS+=("$@"); break ;;
        *)            TEXT_ARGS+=("$1"); shift ;;
    esac
done

# --- Handle daemon commands ---
if [[ "${DAEMON_CMD}" == "stop" ]]; then
    stop_daemon
    exit 0
fi

if [[ "${DAEMON_CMD}" == "restart" ]]; then
    restart_daemon
    exit 0
fi

if [[ "${DAEMON_CMD}" == "status" ]]; then
    if daemon_is_running; then
        echo "speak: daemon running (pid $(cat "${SOCK_PATH}.pid"))" >&2
    else
        echo "speak: daemon not running, starting..." >&2
        start_daemon
    fi
    exit 0
fi

# --- Handle --devices (list audio output devices, no daemon needed) ---
if [[ "${LIST_DEVICES}" == true ]]; then
    uv run --python 3.14 --with sounddevice -- python3 "${SCRIPT_DIR}/speak-list-devices"
    exit 0
fi

# --- Handle --set-device (switch device on running daemon) ---
if [[ -n "${SET_DEVICE:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    # Parse as int when numeric, else send as a device-name string.
    if [[ "${SET_DEVICE}" =~ ^[0-9]+$ ]]; then
        _sd_json="$(jq -cn --argjson d "${SET_DEVICE}" '{device: $d}')"
    else
        _sd_json="$(jq -cn --arg d "${SET_DEVICE}" '{device: $d}')"
    fi
    _sd_resp="$(python3 "${SCRIPT_DIR}/speak-client" --command set_device --json "${_sd_json}")"
    if [[ "$(printf '%s' "${_sd_resp}" | jq -r '.ok')" == "true" ]]; then
        if [[ "$(printf '%s' "${_sd_resp}" | jq -r '.cleared // false')" == "true" ]]; then
            echo "speak: cleared pinned device — now following the current system default"
        else
            printf '%s' "${_sd_resp}" | jq -r '"speak: switched to device \(.device.index) (\(.device.name)) — pinned; survives daemon restarts"'
        fi
    else
        echo "speak: error: $(printf '%s' "${_sd_resp}" | jq -r '.error // "unknown"')" >&2
        exit 1
    fi
    exit 0
fi

# --- Handle --show-device (show the pinned output device setting) ---
if [[ "${SHOW_DEVICE:-false}" == true ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    _shd_resp="$(python3 "${SCRIPT_DIR}/speak-client" --command show_device --json '{}')"
    if [[ "$(printf '%s' "${_shd_resp}" | jq -r '.ok')" == "true" ]]; then
        if [[ "$(printf '%s' "${_shd_resp}" | jq -r '.pinned // "null"')" == "null" ]]; then
            echo "speak: no pinned device — following the current system default output"
        else
            printf '%s' "${_shd_resp}" | jq -r '"speak: pinned device: \(.pinned)"'
        fi
        printf '%s' "${_shd_resp}" | jq -r '"       settings: \(.settings_path)"'
    else
        echo "speak: error: $(printf '%s' "${_shd_resp}" | jq -r '.error // "unknown"')" >&2
        exit 1
    fi
    exit 0
fi

# --- Handle --replay-id (requires running daemon) ---
if [[ -n "${REPLAY_ID:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    if [[ -n "${REPLAY_CLAUSE:-}" ]]; then
        _ri_json="$(jq -cn --argjson id "${REPLAY_ID}" --argjson fc "${REPLAY_CLAUSE}" '{id: $id, from_clause: $fc}')"
    else
        _ri_json="$(jq -cn --argjson id "${REPLAY_ID}" '{id: $id}')"
    fi
    python3 "${SCRIPT_DIR}/speak-client" --command replay_by_id --json "${_ri_json}"
    exit 0
fi

# --- Handle --play-tone (play input-received tone for current session) ---
if [[ -n "${PLAY_TONE:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    if [[ -z "${SESSION}" ]]; then
        SESSION="$(_detect_session)"
    fi
    python3 "${SCRIPT_DIR}/speak-client" --play-tone --session "${SESSION}"
    exit 0
fi

# --- Handle queue commands (require running daemon) ---
if [[ -n "${QUEUE_CMD}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    if [[ "${QUEUE_CMD}" == "resume_mid_clause" ]]; then
        if [[ "${RESUME_MID_CLAUSE_VAL:-}" == "on" ]]; then
            _rmc_json='{"enabled": true}'
        elif [[ "${RESUME_MID_CLAUSE_VAL:-}" == "off" ]]; then
            _rmc_json='{"enabled": false}'
        else
            _rmc_json='{}'
        fi
        _rmc_state="$(python3 "${SCRIPT_DIR}/speak-client" --command set_resume_mid_clause --json "${_rmc_json}" \
            | jq -r 'if .resume_mid_clause then "on" else "off" end')"
        echo "resume-mid-clause: ${_rmc_state}"
        exit 0
    fi
    if [[ "${QUEUE_CMD}" == "history" ]]; then
        _h_json="$(jq -cn --argjson n "${HISTORY_N:-10}" --argjson o "${HISTORY_OFFSET:-0}" '{n: $n, offset: $o}')"
        python3 "${SCRIPT_DIR}/speak-client" --command history --json "${_h_json}" \
            | jq -c '{entries: (.entries // []), total: (.total // 0)}'
    else
        python3 "${SCRIPT_DIR}/speak-client" --command "${QUEUE_CMD}"
    fi
    exit 0
fi

# --- Handle --caller-history ---
if [[ -n "${CALLER_HISTORY_NAME:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    _ch_json="$(jq -cn --arg c "${CALLER_HISTORY_NAME}" --argjson n "${CALLER_HISTORY_N:-10}" --argjson o "${HISTORY_OFFSET:-0}" '{caller: $c, n: $n, offset: $o}')"
    python3 "${SCRIPT_DIR}/speak-client" --command caller_history --json "${_ch_json}" \
        | jq -c '{entries: (.entries // []), total: (.total // 0)}'
    exit 0
fi

# --- Handle --session-history ---
if [[ -n "${SESSION_HISTORY_ID:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    _sh_json="$(jq -cn --arg s "${SESSION_HISTORY_ID}" --argjson n "${SESSION_HISTORY_N:-10}" '{session: $s, n: $n}')"
    python3 "${SCRIPT_DIR}/speak-client" --command session_history --json "${_sh_json}" \
        | jq '.entries // []'
    exit 0
fi

# --- Handle --agent-summary ---
if [[ -n "${AGENT_SUMMARY_PID:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    # Query session history from daemon
    _as_json="$(jq -cn --arg s "${AGENT_SUMMARY_PID}" '{session: $s, n: 50}')"
    _agent_entries="$(python3 "${SCRIPT_DIR}/speak-client" --command session_history --json "${_as_json}" \
        | jq -r '.entries[]?.text')"
    if [[ -z "${_agent_entries}" ]]; then
        "${SCRIPT_DIR}/speak" --enqueue "No history found for session ${AGENT_SUMMARY_PID}."
    else
        _summary="$(printf '%s' "${_agent_entries}" | "${SCRIPT_DIR}/summarize" --max-words 40)"
        if [[ -n "${_summary}" ]]; then
            "${SCRIPT_DIR}/speak" --enqueue "${_summary}"
        else
            "${SCRIPT_DIR}/speak" --enqueue "Could not summarize session history."
        fi
    fi
    exit 0
fi

# --- Handle --agent-repeat ---
if [[ -n "${AGENT_REPEAT_PID:-}" ]]; then
    if ! daemon_is_running; then
        echo "speak: daemon not running (start with: speak --daemon)" >&2
        exit 1
    fi
    # Query session history from daemon
    _ar_json="$(jq -cn --arg s "${AGENT_REPEAT_PID}" --argjson n "${AGENT_REPEAT_N}" '{session: $s, n: $n}')"
    _agent_lines="$(python3 "${SCRIPT_DIR}/speak-client" --command session_history --json "${_ar_json}" \
        | jq -r '.entries[]?.text')"
    if [[ -z "${_agent_lines}" ]]; then
        "${SCRIPT_DIR}/speak" --enqueue "No history found for session ${AGENT_REPEAT_PID}."
    else
        while IFS= read -r _line; do
            "${SCRIPT_DIR}/speak" --enqueue "${_line}"
        done <<< "${_agent_lines}"
    fi
    exit 0
fi

# --- Set default voice for engine ---
if [[ -z "${VOICE}" ]]; then
    case "${ENGINE}" in
        kokoro) VOICE="${DEFAULT_KOKORO_VOICE}" ;;
        piper)  VOICE="${DEFAULT_PIPER_VOICE}" ;;
        *)      echo "speak: unknown engine '${ENGINE}' (use kokoro or piper)" >&2; exit 1 ;;
    esac
fi

# --- List voices ---
if [[ "${LIST_VOICES}" == true ]]; then
    case "${ENGINE}" in
        kokoro)
            uv run --python 3.14 --with kokoro-tts -- kokoro-tts \
                --model "${KOKORO_DIR}/kokoro-v1.0.onnx" \
                --voices "${KOKORO_DIR}/voices-v1.0.bin" \
                --help-voices 2>&1 | grep -v "^Consider"
            ;;
        piper)
            uv run --python 3.14 --with piper-tts --with pathvalidate -- \
                python3 -m piper.download_voices 2>&1 | grep "^en_"
            ;;
    esac
    exit 0
fi

# --- Mute check (allow daemon/queue commands through) ---
if [[ -f "${MUTE_FILE}" ]]; then
    echo "speak: audio mode is muted (use 'speak --unmute' to re-enable)" >&2
    exit 1
fi

# --- Collect text ---
if [[ ${#TEXT_ARGS[@]} -gt 0 ]]; then
    TEXT="${TEXT_ARGS[*]}"
elif [[ ! -t 0 ]]; then
    TEXT="$(cat)"
else
    echo "speak: no text provided" >&2
    echo "Usage: speak [OPTIONS] TEXT  or  echo TEXT | speak" >&2
    exit 1
fi

if [[ -z "${TEXT}" ]]; then
    echo "speak: empty text" >&2
    exit 1
fi

# =============================================================================
# Kokoro engine (daemon-backed)
# =============================================================================
speak_kokoro() {
    # --save writes a WAV file and needs no daemon — handle it before the daemon
    # path. robots-4cb: the kokoro-tts CLI feeds tokens/style/speed but the v1.0
    # ONNX model requires input_ids, so it silently exits 0 writing NOTHING. Route
    # --save through the kokoro-onnx engine (bin/kokoro-stream) that already backs
    # live playback — it emits raw s16le PCM (mono, 24 kHz) and patches the
    # speed-dtype bug — then wrap the PCM into a real WAV via stdlib `wave`. Every
    # failure is LOUD (non-zero exit): a saved-nothing must never look like success.
    if [[ -n "${SAVE_FILE}" ]]; then
        local model="${KOKORO_DIR}/kokoro-v1.0.onnx"
        local voices="${KOKORO_DIR}/voices-v1.0.bin"
        local stream="${SCRIPT_DIR}/kokoro-stream"
        if [[ ! -f "${stream}" ]]; then
            echo "speak: --save failed — kokoro-stream not found at ${stream}" >&2
            exit 1
        fi
        if [[ ! -f "${model}" || ! -f "${voices}" ]]; then
            echo "speak: --save failed — kokoro model/voices missing under ${KOKORO_DIR}" >&2
            exit 1
        fi
        local pcm_tmp
        pcm_tmp="$(mktemp "${TMPDIR:-/tmp}/speak-save.XXXXXX.pcm")" || {
            echo "speak: --save failed — could not create temp file" >&2
            exit 1
        }
        # Render → raw PCM. Do NOT mask the render exit code behind a pipe.
        if ! printf '%s' "${TEXT}" | uv run --python 3.14 --with kokoro-onnx -- \
                python3 "${stream}" \
                --model "${model}" --voices "${voices}" \
                --voice "${VOICE}" --speed "${SPEED}" > "${pcm_tmp}" 2>/dev/null; then
            rm -f "${pcm_tmp}"
            echo "speak: --save failed — kokoro-onnx render error; nothing written to ${SAVE_FILE}" >&2
            exit 1
        fi
        if [[ ! -s "${pcm_tmp}" ]]; then
            rm -f "${pcm_tmp}"
            echo "speak: --save failed — kokoro-onnx produced no audio; nothing written to ${SAVE_FILE}" >&2
            exit 1
        fi
        # Wrap PCM (mono, s16le, 24 kHz) into a proper WAV. stdlib `wave` only.
        if ! python3 - "${pcm_tmp}" "${SAVE_FILE}" <<'PY'
import sys, wave
pcm = open(sys.argv[1], "rb").read()
if len(pcm) % 2:  # s16le is 2 bytes/sample; drop a stray odd byte, don't corrupt a frame
    pcm = pcm[:-1]
with wave.open(sys.argv[2], "wb") as w:
    w.setnchannels(1)
    w.setsampwidth(2)
    w.setframerate(24000)
    w.writeframes(pcm)
PY
        then
            rm -f "${pcm_tmp}"
            echo "speak: --save failed — could not wrap PCM into WAV at ${SAVE_FILE}" >&2
            exit 1
        fi
        rm -f "${pcm_tmp}"
        # Final proof: the file must exist and be non-trivial. Never claim success
        # for a zero-byte or missing WAV (the original silent-failure bug).
        if [[ ! -s "${SAVE_FILE}" ]]; then
            echo "speak: --save failed — wrote nothing to ${SAVE_FILE}" >&2
            exit 1
        fi
        echo "speak: saved to ${SAVE_FILE}" >&2
        return
    fi

    # Auto-start daemon if not running
    if ! daemon_is_running; then
        start_daemon || {
            echo "speak: falling back to direct mode (no daemon)" >&2
            speak_kokoro_direct
            return
        }
    fi

    # Enqueue — the only playback mode (the legacy --stream/ffplay path was retired).
    # Auto-detect caller if not explicitly set
    _auto_detect_caller

    # Detect session (Claude Code ancestor PID or PPID fallback)
    if [[ -z "${SESSION}" ]]; then
        SESSION="$(_detect_session)"
    fi

    # Resolve backend: auto picks fastest available
    local backend="${ENQUEUE_BACKEND}"
    if [[ "${backend}" == "auto" ]]; then
        if [[ -x "${SCRIPT_DIR}/speak-enqueue" ]]; then
            backend="c"
        else
            backend="python"
        fi
    fi

    local _ec=0
    case "${backend}" in
        c)
            local caller_flag=()
            if [[ -n "${CALLER}" ]]; then
                caller_flag=(-c "${CALLER}")
            fi
            # `|| _ec=$?` keeps set -e from aborting AND captures the real
            # pipeline exit code (pipefail => backend's code) for the log.
            printf '%s' "${TEXT}" | "${SCRIPT_DIR}/speak-enqueue" \
                -v "${VOICE}" -s "${SPEED}" -S "${SESSION}" "${caller_flag[@]}" || _ec=$?
            if [[ ${_ec} -ne 0 ]]; then
                _log_failure "enqueue_c" "${_ec}" "${TEXT}"
                exit "${_ec}"
            fi
            ;;
        python)
            local caller_flag=()
            if [[ -n "${CALLER}" ]]; then
                caller_flag=(--caller "${CALLER}")
            fi
            printf '%s' "${TEXT}" | python3 "${SCRIPT_DIR}/speak-client" \
                --enqueue --voice "${VOICE}" --speed "${SPEED}" \
                --session "${SESSION}" "${caller_flag[@]}" || _ec=$?
            if [[ ${_ec} -ne 0 ]]; then
                _log_failure "enqueue_python" "${_ec}" "${TEXT}"
                exit "${_ec}"
            fi
            ;;
        *)
            echo "speak: unknown enqueue backend '${backend}' (use c or python)" >&2
            exit 1
            ;;
    esac
}

# Fallback: direct mode without daemon (cold start each time)
speak_kokoro_direct() {
    _require_ffplay
    local model="${KOKORO_DIR}/kokoro-v1.0.onnx"
    local voices="${KOKORO_DIR}/voices-v1.0.bin"

    if [[ ! -f "${model}" || ! -f "${voices}" ]]; then
        echo "speak: kokoro model files not found in ${KOKORO_DIR}" >&2
        exit 1
    fi

    printf '%s' "${TEXT}" | uv run --python 3.14 --with kokoro-onnx -- \
        python3 "${SCRIPT_DIR}/kokoro-stream" \
            --model "${model}" --voices "${voices}" \
            --voice "${VOICE}" --speed "${SPEED}" \
    | ffplay -nodisp -autoexit -f s16le -ar 24000 -ch_layout mono -i pipe:0 -loglevel quiet
}

# =============================================================================
# Piper engine
# =============================================================================
speak_piper() {
    _require_ffplay
    command -v jq >/dev/null 2>&1 || { echo "speak: piper engine requires jq" >&2; exit 1; }

    local model="${PIPER_VOICES_DIR}/${VOICE}.onnx"
    local config="${model}.json"

    # Download voice if needed
    if [[ ! -f "${model}" ]]; then
        echo "speak: downloading piper voice '${VOICE}'..." >&2
        mkdir -p "${PIPER_VOICES_DIR}"
        uv run --python 3.14 --with piper-tts --with pathvalidate -- \
            python3 -m piper.download_voices --download-dir "${PIPER_VOICES_DIR}" "${VOICE}"
        if [[ ! -f "${model}" ]]; then
            echo "speak: failed to download voice '${VOICE}'" >&2
            exit 1
        fi
        echo "speak: voice ready." >&2
    fi

    if [[ ! -f "${config}" ]]; then
        echo "speak: missing config ${config}" >&2
        exit 1
    fi

    local sample_rate
    sample_rate="$(jq -r '.audio.sample_rate' "${config}")"
    if [[ -z "${sample_rate}" || "${sample_rate}" == "null" ]]; then
        sample_rate=22050
    fi

    if [[ -n "${SAVE_FILE}" ]]; then
        printf '%s' "${TEXT}" | uv run --python 3.14 --with piper-tts --with pathvalidate -- \
            piper -m "${model}" -c "${config}" \
                  --length-scale "${SPEED}" \
                  --output_file "${SAVE_FILE}"
        echo "speak: saved to ${SAVE_FILE}" >&2
    else
        printf '%s' "${TEXT}" | uv run --python 3.14 --with piper-tts --with pathvalidate -- \
            piper -m "${model}" -c "${config}" \
                  --length-scale "${SPEED}" \
                  --output-raw \
        | ffplay -nodisp -autoexit -f s16le -ar "${sample_rate}" -ch_layout mono -i pipe:0 -loglevel quiet
    fi
}

# --- Dispatch to engine ---
case "${ENGINE}" in
    kokoro) speak_kokoro ;;
    piper)  speak_piper ;;
    *)      echo "speak: unknown engine '${ENGINE}' (use kokoro or piper)" >&2; exit 1 ;;
esac
